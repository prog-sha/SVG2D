[configuration]

entry_symbol = "svg2d_init"
compatibility_minimum = "4.7"
reloadable = false

[libraries]

macos.debug = "./bin/macos/libsvg2d.macos.template_debug.dylib"
macos.release = "./bin/macos/libsvg2d.macos.template_release.dylib"
windows.debug.x86_64 = "./bin/windows/svg2d.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "./bin/windows/svg2d.windows.template_release.x86_64.dll"
