[configuration]

entry_symbol = "svg2d_init"
compatibility_minimum = "4.7"
reloadable = false

[libraries]

macos.debug = "./bin/macos/libsvg2d.macos.template_debug.dylib"
macos.release = "./bin/macos/libsvg2d.macos.template_release.dylib"
windows.debug.x86_64 = "./bin/windows/svg2d.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "./bin/windows/svg2d.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "./bin/linux/libsvg2d.linux.template_debug.x86_64.so"
linux.release.x86_64 = "./bin/linux/libsvg2d.linux.template_release.x86_64.so"
linux.debug.arm64 = "./bin/linux/libsvg2d.linux.template_debug.arm64.so"
linux.release.arm64 = "./bin/linux/libsvg2d.linux.template_release.arm64.so"
android.debug.arm64 = "./bin/android/libsvg2d.android.template_debug.arm64.so"
android.release.arm64 = "./bin/android/libsvg2d.android.template_release.arm64.so"
ios.debug.arm64 = "./bin/ios/libsvg2d.ios.template_debug.arm64.dylib"
ios.release.arm64 = "./bin/ios/libsvg2d.ios.template_release.arm64.dylib"
web.debug.wasm32 = "./bin/web/libsvg2d.web.template_debug.wasm32.nothreads.wasm"
web.release.wasm32 = "./bin/web/libsvg2d.web.template_release.wasm32.nothreads.wasm"
